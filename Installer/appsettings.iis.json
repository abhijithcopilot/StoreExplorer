{
  "AllowedHosts": "*",
  "AllowedOrigin": "https://sdpauto1",
  "LogQueries": false,
  "Witsml": {
    "ClientCapabilities": {
      "Name": "Store Explorer",
      "Description": "Browser interface for WITSML servers"
    }
  },
  "Etp": {
    "IdleTimeout": "00:10:00",
    "AppName": "Store Explorer",
    "AppVersion": "1.0.0"
  },
  "OAuth2Enabled": false,
  "enableHttp": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs\\api-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message}{NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 30,
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
