# API sub-application hosted alongside the frontend under the same IIS website.
# Frontend: https://<hostname>/storeExplorer
# API:       https://<hostname>/storeExplorer-api
#
# INSTALL_HOSTNAME is a placeholder replaced at install time by Install-StoreExplorer.ps1.
# Do NOT change INSTALL_HOSTNAME here — edit the hostname in the installer script instead.
VITE_WITSMLEXPLORER_API_URL=https://INSTALL_HOSTNAME/storeExplorer-api
VITE_MSALENABLED=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_URL_WITSMLEXPLORER=https://INSTALL_HOSTNAME/storeExplorer/
VITE_AZURE_AD_SCOPE_API=
